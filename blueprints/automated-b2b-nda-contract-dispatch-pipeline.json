{
  "name": "Arkgon Systems // Zero-Touch B2B Mutual NDA Generation & CRM Sync (automated-b2b-nda-contract-dispatch-pipeline)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hookLabel": "automated-b2b-nda-contract-dispatch-pipeline-webhook",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "notes": "Real-time event trigger from Make"
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "idempotency_key",
            "value": "{{sha256(1.id + ':' + 1.updated_at)}}"
          },
          {
            "name": "dispatch_state",
            "value": "{{lower(1.status)}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "notes": "SHA-256 idempotency guard for nda_contract"
      }
    },
    {
      "id": 3,
      "module": "hubspotcrm:ActionCreateUpdateObject",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/batch/upsert",
        "method": "post",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"entity_id\":\"{{1.id}}\",\"idempotency_key\":\"{{2.idempotency_key}}\",\"state\":\"{{2.dispatch_state}}\",\"pipeline\":\"automated-b2b-nda-contract-dispatch-pipeline\"}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "notes": "Upsert into HubSpot (https://api.hubapi.com/crm/v3/objects/deals/batch/upsert)"
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false
    },
    "arkgon_spec_id": 17,
    "slug": "automated-b2b-nda-contract-dispatch-pipeline"
  }
}