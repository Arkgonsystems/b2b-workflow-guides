{
  "name": "Product-Qualified Lead (PQL) Trial Usage Alert Engine",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "parameters": {
        "hook": "product-qualified-lead-pql-trial-usage-alert-engine-webhook"
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "mapper": {
        "idempotency_key": "{{sha256(1.event_id + \"_\" + 1.updated_at)}}"
      }
    },
    {
      "id": 3,
      "module": "make:WatchRecords"
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter"
    },
    {
      "id": 5,
      "module": "hubspot:ActionUpsertRecord"
    }
  ]
}