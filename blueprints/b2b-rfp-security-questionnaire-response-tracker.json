{
  "name": "B2B RFP & Security Questionnaire Response Tracker",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "parameters": {
        "hook": "b2b-rfp-security-questionnaire-response-tracker-webhook"
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "mapper": {
        "idempotency_key": "{{sha256(1.event_id + \"_\" + 1.updated_at)}}"
      }
    },
    {
      "id": 3,
      "module": "notion:WatchRecords"
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter"
    },
    {
      "id": 5,
      "module": "airtable:ActionUpsertRecord"
    }
  ]
}