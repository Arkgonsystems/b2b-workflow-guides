{
  "name": "Arkgon Systems // Automated B2B Deal Desk Discount Approval Pipeline (hubspot-deal-stage-slack-approval-workflow)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hookLabel": "hubspot-deal-stage-slack-approval-workflow-webhook",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "notes": "Real-time event trigger from Make"
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "idempotency_key",
            "value": "{{sha256(1.id + ':' + 1.updated_at)}}"
          },
          {
            "name": "slack_state",
            "value": "{{lower(1.status)}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "notes": "SHA-256 idempotency guard for deal_stage"
      }
    },
    {
      "id": 3,
      "module": "hubspotcrm:ActionCreateUpdateObject",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.hubapi.com/crm/v3/objects/deals/batch/upsert",
        "method": "post",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"entity_id\":\"{{1.id}}\",\"idempotency_key\":\"{{2.idempotency_key}}\",\"state\":\"{{2.slack_state}}\",\"pipeline\":\"hubspot-deal-stage-slack-approval-workflow\"}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "notes": "Upsert into HubSpot (https://api.hubapi.com/crm/v3/objects/deals/batch/upsert)"
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false
    },
    "arkgon_spec_id": 12,
    "slug": "hubspot-deal-stage-slack-approval-workflow"
  }
}