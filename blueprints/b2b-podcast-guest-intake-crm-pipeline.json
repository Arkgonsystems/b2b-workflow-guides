{
  "name": "Arkgon Systems Turnkey Spec: Automated B2B Podcast & Webinar Guest Intake Pipeline",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "b2b-podcast-guest-intake-crm-pipeline-webhook",
        "maxResults": 1
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "mapper": {
        "idempotency_key": "{{sha256(1.event_id + \"_\" + 1.updated_at)}}"
      }
    },
    {
      "id": 3,
      "module": "make:WatchRecords",
      "version": 1
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter",
      "version": 1
    },
    {
      "id": 5,
      "module": "notion:ActionUpsertRecord",
      "version": 1
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "zone": "us1.make.com"
  }
}