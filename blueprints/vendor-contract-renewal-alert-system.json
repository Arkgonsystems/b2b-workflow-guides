{
  "name": "Arkgon Systems Turnkey Spec: SaaS Spend & Vendor Contract Renewal Alert Tracker",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": "vendor-contract-renewal-alert-system-ingest-webhook",
        "maxResults": 1
      },
      "metadata": {
        "notes": "Step 1: Real-time webhook listener from Airtable"
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "mapper": {
        "idempotency_key": "{{sha256(1.event_id + \"_\" + 1.updated_at)}}",
        "timestamp": "{{formatDate(now; \"YYYY-MM-DDTHH:mm:ssZ\")}}"
      },
      "metadata": {
        "notes": "Step 2: Deterministic SHA-256 idempotency hash"
      }
    },
    {
      "id": 3,
      "module": "airtable:WatchRecords",
      "version": 1,
      "mapper": {
        "external_id": "{{1.event_id}}"
      },
      "metadata": {
        "notes": "Step 3: Source state verification in Airtable"
      }
    },
    {
      "id": 4,
      "module": "builtin:BasicRouter",
      "version": 1,
      "metadata": {
        "notes": "Step 4: Conditional validation & Dead-Letter Queue router"
      }
    },
    {
      "id": 5,
      "module": "make:ActionUpsertRecord",
      "version": 1,
      "mapper": {
        "idempotency_signature": "{{2.idempotency_key}}",
        "status": "VERIFIED_SYNC"
      },
      "metadata": {
        "notes": "Step 5: Atomic upsert into Make"
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true
    },
    "zone": "us1.make.com"
  }
}