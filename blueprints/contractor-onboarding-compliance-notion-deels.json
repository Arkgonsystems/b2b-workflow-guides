{
  "name": "Arkgon Systems // Automated Contractor Onboarding & Document Collection (contractor-onboarding-compliance-notion-deels)",
  "flow": [
    {
      "id": 1,
      "module": "notion:WatchDatabaseItems",
      "version": 1,
      "parameters": {
        "hookLabel": "contractor-onboarding-compliance-notion-deels-webhook",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "notes": "Real-time event trigger from Notion"
      }
    },
    {
      "id": 2,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "idempotency_key",
            "value": "{{sha256(1.id + ':' + 1.updated_at)}}"
          },
          {
            "name": "compliance_state",
            "value": "{{lower(1.status)}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "notes": "SHA-256 idempotency guard for contractor_onboarding"
      }
    },
    {
      "id": 3,
      "module": "util:SetVariable2",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://hook.eu1.make.com/ingest",
        "method": "post",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"entity_id\":\"{{1.id}}\",\"idempotency_key\":\"{{2.idempotency_key}}\",\"state\":\"{{2.compliance_state}}\",\"pipeline\":\"contractor-onboarding-compliance-notion-deels\"}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "notes": "Upsert into Make (https://hook.eu1.make.com/ingest)"
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "sequential": false
    },
    "arkgon_spec_id": 3,
    "slug": "contractor-onboarding-compliance-notion-deels"
  }
}