        "notes": "SHA-256 idempotency guard for agency_retainer"
      }
    },
    {
      "id": 3,
      "module": "notion:ActionCreateDatabaseItem",
      "version": 3,
      "parameters": {
        "handleErrors": true
      },
      "mapper": {
        "url": "https://api.notion.com/v1/pages",
        "method": "post",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"entity_id\":\"{{1.id}}\",\"idempotency_key\":\"{{2.idempotency_key}}\",\"state\":\"{{2.hours_state}}\",\"pipeline\":\"agency-retainer-hours-burn-rate-tracker\"}"
