      "version": 1,
      "parameters": {
        "hookLabel": "agency-retainer-hours-burn-rate-tracker-webhook",
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
